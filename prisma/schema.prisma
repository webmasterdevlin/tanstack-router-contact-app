// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma" // Adjust the path as needed
}

datasource db {
    provider          = "sqlite"
    url               = "file:./dev.db"
}

model Contact {
  id        String   @id @default(uuid())
  first     String?
  last      String?
  createdAt DateTime @default(now())
  favorite  Boolean?
  avatar    String?
  twitter   String?
  notes     String?
}